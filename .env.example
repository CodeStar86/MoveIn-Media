# These are server-side secrets. Configure through Vercel Project Settings > Environment Variables.
# Keep server secrets private. Only the public Turnstile site key has a VITE_ prefix.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Public browser credentials for the staff dashboard (safe to expose; RLS protects data)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
VITE_TURNSTILE_SITE_KEY=YOUR_PUBLIC_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_PRIVATE_TURNSTILE_SECRET_KEY
RESEND_API_KEY=REPLACE_ME
BOOKING_FROM_EMAIL=bookings@your-verified-domain.example
BOOKING_TO_EMAIL=you@your-domain.example
BOOKING_ALLOWED_ORIGIN=https://your-production-domain.example
